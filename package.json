{
  "name": "autonomous-corps-command-school",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:ci": "vitest run --exclude tests/simulation/monte-carlo-operation.test.ts --exclude tests/simulation/operation-evaluation.test.ts --exclude tests/simulation/bridge-defense-evaluation.test.ts",
    "test:monte-carlo": "vitest run tests/simulation/monte-carlo-operation.test.ts tests/simulation/operation-evaluation.test.ts tests/simulation/bridge-defense-evaluation.test.ts",
    "assets:sprites": "tsx scripts/assets/generate-officer-sprites.mjs",
    "assets:maps": "tsx scripts/assets/generate-battlefield-map.mjs",
    "check:assets:sprites": "tsx scripts/assets/generate-officer-sprites.mjs --check",
    "check:assets:maps": "tsx scripts/assets/generate-battlefield-map.mjs --check",
    "check:assets": "npm run check:assets:sprites && npm run check:assets:maps",
    "evaluate:operations": "tsx scripts/evaluate-operations.ts",
    "simulate:squad-battle": "tsx scripts/simulate-squad-battle.ts",
    "check:dependencies": "node scripts/check-dependencies.mjs",
    "check": "npm run check:assets && npm run build && npm test && npm run check:dependencies",
    "check:ci": "npm run check:assets && npm run build && npm run test:ci && npm run check:dependencies"
  },
  "devDependencies": {
    "jsdom": "30.0.1",
    "tsx": "^4.20.6",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
